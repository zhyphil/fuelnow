{
  "name": "@fuel-now/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:load-local": "node --import tsx src/quality/runLocalLoad.ts",
    "quality:geography": "node --env-file-if-exists=../../.env --import tsx src/quality/runGeographyAudit.ts",
    "quality:prices": "node --env-file-if-exists=../../.env --import tsx src/quality/runPriceAudit.ts",
    "client:types": "node --import tsx src/api/generateClientContract.ts",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/api/start.ts",
    "db:down": "docker compose --file ../../compose.yaml down",
    "db:migrate": "docker compose --file ../../compose.yaml exec -T db sh /migrations/apply-migrations.sh",
    "db:up": "docker compose --file ../../compose.yaml up --detach --wait db",
    "db:verify": "docker compose --file ../../compose.yaml exec -T db sh /migrations/verify-all.sh",
    "start": "node --env-file-if-exists=../../.env --import tsx src/api/start.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/type-provider-typebox": "5.2.0",
    "@fuel-now/config": "workspace:*",
    "@fuel-now/data-core": "workspace:*",
    "@fuel-now/contracts": "workspace:*",
    "@sinclair/typebox": "0.34.52",
    "fastify": "5.12.1",
    "pg": "8.23.0",
    "tsx": "4.23.13"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "openapi-typescript": "7.13.0"
  }
}
