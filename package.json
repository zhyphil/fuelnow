{
  "name": "fuel-now",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "mobile:dev": "pnpm --filter @fuel-now/mobile dev",
    "mobile:export": "pnpm --filter @fuel-now/mobile export",
    "api:types": "pnpm --filter @fuel-now/api client:types",
    "api:types:check": "pnpm --filter @fuel-now/api client:types --check",
    "api:dev": "pnpm --filter @fuel-now/api dev",
    "api:start": "pnpm --filter @fuel-now/api start",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm api:types:check && pnpm test",
    "db:down": "pnpm --filter @fuel-now/api db:down",
    "db:migrate": "pnpm --filter @fuel-now/api db:migrate",
    "db:up": "pnpm --filter @fuel-now/api db:up",
    "db:verify": "pnpm --filter @fuel-now/api db:verify",
    "format": "prettier --write --ignore-unknown .github apps packages compose.yaml package.json tsconfig.json pnpm-workspace.yaml eslint.config.js .prettierrc.json",
    "format:check": "prettier --check --ignore-unknown .github apps packages compose.yaml package.json tsconfig.json pnpm-workspace.yaml eslint.config.js .prettierrc.json",
    "lint": "eslint .",
    "test": "pnpm --recursive test",
    "typecheck": "pnpm --recursive typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.3.0",
    "@types/react": "19.2.4",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "5.9.2",
    "typescript-eslint": "8.69.0",
    "vitest": "3.2.4"
  }
}
