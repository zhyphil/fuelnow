# Fuel Now local development configuration
# Copy to .env for local use. Never commit the copied file or real credentials.

# Runtime
APP_ENV=development
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=debug

# PostgreSQL/PostGIS — local development placeholder credentials only
DATABASE_URL=postgresql://fuel_now:fuel_now@127.0.0.1:5432/fuel_now
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=10

# Source synchronization is opt-in outside the dedicated worker.
SOURCE_SYNC_ENABLED=false
SOURCE_FR_FUEL_ENABLED=false
SOURCE_ES_FUEL_ENABLED=false
SOURCE_FR_IRVE_STATIC_ENABLED=false
SOURCE_FR_QUALICHARGE_DYNAMIC_ENABLED=false
SOURCE_FR_PAN_DYNAMIC_SHADOW_ENABLED=false
SOURCE_ES_RIPREE_ENABLED=false
SOURCE_ES_REVE_ENABLED=false
SOURCE_OSM_AIR_WASH_ENABLED=false
SOURCE_HTTP_TIMEOUT_MS=15000
SOURCE_HTTP_MAX_RETRIES=2
RAW_SNAPSHOT_RETENTION_DAYS=30

# Server-only provider credentials — intentionally blank
# Request Reve access only after commercial terms and production quota are approved.
REVE_API_KEY=
# Matrix requests run on the backend; never expose this token through EXPO_PUBLIC_*.
MAPBOX_ACCESS_TOKEN=

# Routing budget. Zero disables paid Matrix calls and uses straight-line fallback.
MAPBOX_MONTHLY_ELEMENT_BUDGET=0
MAPBOX_ELEMENTS_PER_SEARCH_MAX=10
ROUTE_CACHE_TTL_SECONDS=300

# Regional OSM import. Use an extract/self-hosted/approved managed input, not public
# Overpass as the application request backend.
OSM_PBF_PATH=

# API security and observability
CORS_ALLOWED_ORIGINS=http://localhost:8081
RATE_LIMIT_MAX_PER_MINUTE=60
OTEL_EXPORTER_OTLP_ENDPOINT=

# Mobile-public configuration. Every EXPO_PUBLIC_* value is visible in the app.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
